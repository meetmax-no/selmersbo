---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { getSettings } from '../lib/settings';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Aktivhuset Selmersbo – et varmt fællesskab og et væld af aktiviteter for seniorer i Hørsholm.',
  noindex = false,
} = Astro.props;

// Årstidspalet vælges i CMS'et (Indstillinger). Sætter data-theme på <html>.
const settings = await getSettings();
const theme = settings.theme ?? 'efteraar';
const themeColor: Record<string, string> = {
  efteraar: '#2e6a4e', vinter: '#1f5d5f', foraar: '#367a41', sommer: '#227d6b',
};

// Absolutte URL'er til SEO/deling (bruger `site` fra astro.config).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og-image.jpg', Astro.site).href : '/og-image.jpg';
---
<!doctype html>
<html lang="da" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor[theme] ?? themeColor.efteraar} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content="Aktivhuset Selmersbo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a href="#main" class="skip-link">Spring til indhold</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
