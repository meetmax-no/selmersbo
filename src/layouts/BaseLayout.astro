---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { getEntry } from 'astro:content';
import { getSettings } from '../lib/settings';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Aktivhuset Selmersbo – et varmt fællesskab og et væld af aktiviteter for seniorer i Hørsholm.',
  noindex = false,
} = Astro.props;

// Årstidspalet vælges i CMS'et (Indstillinger). Sætter data-theme på <html>.
const settings = await getSettings();
const theme = settings.theme ?? 'efteraar';
const themeColor: Record<string, string> = {
  efteraar: '#2e6a4e', vinter: '#1f5d5f', foraar: '#367a41', sommer: '#227d6b',
};

// Absolutte URL'er til SEO/deling (bruger `site` fra astro.config).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og-image.jpg', Astro.site).href : '/og-image.jpg';

// Nyhedsflash (vigtig besked) – styres fra CMS: popup, banner eller slukket.
const flashEntry = await getEntry('newsflash', 'index');
const flash = flashEntry?.data;
const flashOn = !!flash && flash.status !== 'off';
// Nøgle der ændrer sig, når beskeden ændres → popup/banner regnes som ulæst
// og vises igen, også i samme besøg.
const flashText = flash ? `${flash.heading}|${flash.body}` : '';
let flashHash = 0;
for (let i = 0; i < flashText.length; i++) flashHash = (Math.imul(flashHash, 31) + flashText.charCodeAt(i)) | 0;
const flashKey = String(flashHash >>> 0);
---
<!doctype html>
<html lang="da" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor[theme] ?? themeColor.efteraar} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content="Aktivhuset Selmersbo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a href="#main" class="skip-link">Spring til indhold</a>

    <Header />

    {flashOn && flash.status === 'banner' && (
      <aside class="flash-banner" id="flash-banner" role="region" aria-label={flash.heading} data-flash-key={flashKey}>
        <div class="container flash-banner-inner">
          <span class="flash-tag">{flash.heading}</span>
          <span class="flash-msg">{flash.body}</span>
          {flash.ctaUrl && flash.ctaLabel && <a class="flash-cta" href={flash.ctaUrl}>{flash.ctaLabel}</a>}
          <button class="flash-close" type="button" data-flash-close aria-label="Luk beskeden">✕</button>
        </div>
      </aside>
    )}

    <main id="main">
      <slot />
    </main>
    <Footer />

    {flashOn && flash.status === 'popup' && (
      <dialog class="flash-dialog" id="flash-dialog" aria-label={flash.heading} data-flash-key={flashKey}>
        <div class="flash-dialog-inner">
          <span class="flash-tag">{flash.heading}</span>
          <p class="flash-msg">{flash.body}</p>
          <div class="flash-actions">
            {flash.ctaUrl && flash.ctaLabel && <a class="btn btn--primary" href={flash.ctaUrl}>{flash.ctaLabel}</a>}
            <button class="btn btn--ghost" type="button" data-flash-close>Luk</button>
          </div>
        </div>
      </dialog>
    )}

    {flashOn && (
      <script is:inline>
        (function () {
          var d = document.getElementById('flash-dialog');
          if (d && typeof d.showModal === 'function') {
            var key = 'flash-seen-' + (d.getAttribute('data-flash-key') || '');
            var seen = false;
            try { seen = !!sessionStorage.getItem(key); } catch (e) {}
            if (!seen) {
              d.showModal();
              try { sessionStorage.setItem(key, '1'); } catch (e) {}
            }
            d.querySelectorAll('[data-flash-close]').forEach(function (b) { b.addEventListener('click', function () { d.close(); }); });
            d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
          }
          var ban = document.getElementById('flash-banner');
          if (ban) {
            var bkey = 'flash-banner-seen-' + (ban.getAttribute('data-flash-key') || '');
            try { if (sessionStorage.getItem(bkey)) ban.hidden = true; } catch (e) {}
            var bc = ban.querySelector('[data-flash-close]');
            if (bc) bc.addEventListener('click', function () { ban.hidden = true; try { sessionStorage.setItem(bkey, '1'); } catch (e) {} });
          }
        })();
      </script>
    )}

    <Analytics />
  </body>
</html>

<style>
  /* Nyhedsflash – banner + popup */
  .flash-banner { background: var(--terra); color: #fff; }
  .flash-banner[hidden] { display: none; }
  .flash-banner-inner { display: flex; align-items: center; gap: 0.85rem; padding: 0.7rem 0; flex-wrap: wrap; }
  .flash-tag { flex: none; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; font-size: 0.85rem; background: rgba(255, 255, 255, 0.2); padding: 0.2rem 0.65rem; border-radius: 999px; }
  .flash-banner .flash-msg { font-weight: 600; }
  .flash-banner .flash-cta { color: #fff; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  .flash-close { margin-left: auto; flex: none; background: transparent; border: none; color: #fff; font-size: 1.05rem; line-height: 1; cursor: pointer; padding: 0.35rem 0.5rem; border-radius: 8px; }
  .flash-close:hover { background: rgba(255, 255, 255, 0.18); }

  .flash-dialog { width: min(520px, calc(100% - 2rem)); border: none; border-top: 6px solid var(--terra); border-radius: var(--radius-lg); padding: 0; background: var(--paper); color: var(--ink); box-shadow: var(--shadow-lg); }
  .flash-dialog::backdrop { background: rgba(20, 19, 15, 0.6); }
  .flash-dialog-inner { padding: 2rem 1.9rem 1.7rem; text-align: center; }
  .flash-dialog .flash-tag { display: inline-block; background: var(--terra); color: #fff; margin-bottom: 0.9rem; }
  .flash-dialog .flash-msg { white-space: pre-line; font-size: 1.18rem; line-height: 1.5; margin: 0 0 1.5rem; }
  .flash-actions { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }
</style>
