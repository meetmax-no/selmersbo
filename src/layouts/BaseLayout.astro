---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/settings';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Aktivhuset Selmersbo – et varmt fællesskab og et væld af aktiviteter for seniorer i Hørsholm.',
} = Astro.props;

// Årstidspalet vælges i CMS'et (Indstillinger). Sætter data-theme på <html>.
const settings = await getSettings();
const theme = settings.theme ?? 'efteraar';
const themeColor: Record<string, string> = {
  efteraar: '#2e6a4e', vinter: '#1f5d5f', foraar: '#367a41', sommer: '#227d6b',
};
---
<!doctype html>
<html lang="da" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor[theme] ?? themeColor.efteraar} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
  </head>
  <body>
    <a href="#main" class="skip-link">Spring til indhold</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
