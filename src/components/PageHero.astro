---
import Icon from './Icon.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  icon?: string;
}
const { eyebrow, title, lead, icon = 'calendar' } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow"><Icon name={icon} size={18} /> {eyebrow}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem; }
  .page-hero .lead { margin-bottom: 0; }
</style>
