---
import { nav } from '../data/site';
import { getSettings } from '../lib/settings';
import Icon from './Icon.astro';
const site = await getSettings();
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : href.startsWith('/') && path.startsWith(href);
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${site.full} – forside`}>
      <span class="brand-mark" aria-hidden="true">S</span>
      <span class="brand-text">
        <span class="brand-name">Selmersbo</span>
        <span class="brand-tag">{site.tagline}</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <a class="btn btn--accent header-cta-mobile" href="#bliv-medlem">Bliv medlem</a>
    <a class="header-search-mobile" href="/soeg" aria-label="Søg på siden" aria-current={isActive('/soeg') ? 'page' : undefined}>
      <Icon name="search" size={22} />
    </a>
    <label for="nav-toggle" class="nav-burger" aria-label="Åbn menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Hovedmenu">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="nav-search" href="/soeg" aria-current={isActive('/soeg') ? 'page' : undefined}>
        <Icon name="search" size={20} /> <span>Søg</span>
      </a>
      <a class="btn btn--accent nav-cta" href="#bliv-medlem">Bliv medlem</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 78px;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(1.1rem, 3vw, 2rem);
  }

  .brand { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; }
  .brand-mark {
    display: grid; place-items: center;
    width: 46px; height: 46px;
    background: var(--green); color: #fff;
    font-family: var(--font-display); font-weight: 600; font-size: 1.5rem;
    border-radius: 14px; box-shadow: var(--shadow-sm);
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand-name { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; color: var(--ink); letter-spacing: -0.01em; }
  .brand-tag { font-size: 0.82rem; color: var(--muted); font-weight: 500; }

  .site-nav { display: flex; align-items: center; gap: 1.1rem; }
  .site-nav ul { display: flex; gap: 0.95rem; list-style: none; margin: 0; padding: 0; }
  .site-nav a {
    color: var(--ink); text-decoration: none; font-weight: 550; font-size: 0.98rem;
    padding: 0.35rem 0; border-bottom: 2px solid transparent; white-space: nowrap;
  }
  .site-nav a:not(.nav-cta):hover { color: var(--green-700); border-color: var(--green); }
  .site-nav a[aria-current='page']:not(.nav-cta) { color: var(--green-700); border-color: var(--green); }
  /* CTA needs higher specificity than `.site-nav a` so its white text wins */
  .site-nav a.nav-cta { color: #ffffff; border-color: transparent; padding: 0.7rem 1.15rem; min-height: 46px; }
  .site-nav a.nav-cta:hover { color: #ffffff; }

  /* Search entry points */
  .nav-search { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--ink); text-decoration: none; font-weight: 550; font-size: 0.98rem; white-space: nowrap; }
  .nav-search :global(svg) { color: var(--green-700); }
  .nav-search:hover, .nav-search[aria-current='page'] { color: var(--green-700); }
  .header-search-mobile { display: none; }

  /* Mobile menu (CSS-only, checkbox toggle) */
  .nav-burger { display: none; }
  .nav-toggle { display: none; }
  .header-cta-mobile { display: none; }

  @media (max-width: 1360px) {
    .nav-burger {
      display: inline-flex; flex-direction: column; gap: 5px;
      width: 48px; height: 48px; align-items: center; justify-content: center;
      border: 1px solid var(--line); border-radius: 12px; background: var(--paper); cursor: pointer;
    }
    .nav-burger span { width: 22px; height: 2.5px; background: var(--ink); border-radius: 2px; transition: 0.2s; }

    /* Keep the primary CTA visible next to the burger */
    .header-cta-mobile {
      display: inline-flex; margin-left: auto;
      padding: 0.6rem 1.05rem; min-height: 44px; font-size: 1rem;
      color: #ffffff; border-color: transparent; white-space: nowrap;
    }
    .header-cta-mobile:hover { color: #ffffff; }

    .site-nav {
      position: absolute; inset: 78px 0 auto 0;
      flex-direction: column; align-items: stretch; gap: 0.4rem;
      background: var(--paper); border-bottom: 1px solid var(--line);
      padding: 1rem clamp(1.1rem, 4vw, 2.5rem) 1.5rem;
      box-shadow: var(--shadow-md);
      transform: translateY(-140%); transition: transform 0.25s ease; visibility: hidden;
    }
    .site-nav ul { flex-direction: column; gap: 0.2rem; }
    .site-nav a { padding: 0.75rem 0; font-size: 1.15rem; border-bottom: 1px solid var(--line); }
    /* The CTA now lives next to the burger, so hide the in-menu copy */
    .site-nav .nav-cta { display: none; }
    /* Search appears both as a menu item and as an icon next to the burger */
    .nav-search { padding: 0.75rem 0; font-size: 1.15rem; border-bottom: 1px solid var(--line); }
    .header-search-mobile {
      display: inline-flex; align-items: center; justify-content: center;
      width: 48px; height: 48px; flex: none; margin-left: 0.5rem;
      border: 1px solid var(--line); border-radius: 12px; background: var(--paper); color: var(--green-700);
    }

    .nav-toggle:checked ~ .site-nav { transform: translateY(0); visibility: visible; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }
  }

  /* Very small phones: give the CTA + burger room (search stays in the menu) */
  @media (max-width: 430px) {
    .brand-tag { display: none; }
    .brand-name { font-size: 1.3rem; }
    .header-cta-mobile { padding: 0.55rem 0.85rem; font-size: 0.95rem; }
    .header-search-mobile { display: none; }
  }
  @media (max-width: 380px) {
    .header-inner { gap: 0.5rem; padding-inline: 0.8rem; }
    .brand-mark { width: 40px; height: 40px; font-size: 1.25rem; }
    .brand-name { font-size: 1.1rem; }
    .header-cta-mobile { padding: 0.5rem 0.7rem; font-size: 0.9rem; min-height: 42px; }
    .nav-burger { width: 44px; height: 44px; }
  }
</style>
