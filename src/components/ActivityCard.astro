---
import Icon from './Icon.astro';
import type { Activity } from '../data/activities';
interface Props { activity: Activity; }
const { activity } = Astro.props;
---
<article class="activity">
  <div class="activity-icon" aria-hidden="true">
    <Icon name={activity.icon} size={26} />
  </div>
  <div class="activity-body">
    <div class="activity-head">
      <h3>{activity.title}</h3>
      <span class="chip chip--sand">{activity.day}</span>
    </div>
    <p>{activity.text}</p>
  </div>
</article>

<style>
  .activity {
    display: flex; gap: 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 1.4rem;
    height: 100%;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .activity:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--green); }
  .activity-icon {
    flex: none; width: 52px; height: 52px; border-radius: 14px;
    display: grid; place-items: center;
    background: var(--green-050); color: var(--green-700);
  }
  .activity-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
  .activity h3 { margin: 0 0 0.15rem; font-size: 1.28rem; }
  .activity p { margin: 0.4rem 0 0; color: var(--muted); font-size: 1.02rem; }
</style>
