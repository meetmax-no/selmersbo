---
export const prerender = false;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { getStats, listMonths, type Stats, type RestEntry } from '../lib/analytics';

// Periode: ingen parameter = de sidste 30 dage; ?periode=2026-09 = den måned.
// Ukendte/for gamle måneder falder tilbage til de sidste 30 dage.
const months = listMonths();
const wanted = Astro.url.searchParams.get('periode');
const month = months.find((m) => m.key === wanted) ?? null;

// Live besøgstal fra Vercel. Falder tilbage til "tom" tilstand hvis der ikke er
// token/data endnu, så siden aldrig fejler.
const EMPTY: Stats = { updated: new Date().toISOString().slice(0, 10), rangeDays: 30, month, collecting: false, visitors: 0, pageviews: 0, topPages: [], topActivities: [], topExcursions: [], topLetters: [], devices: [] };
const stats: Stats = (await getStats(month)) ?? EMPTY;

// Pæne danske sidenavne til de mest almindelige stier.
const BASE_LABELS: Record<string, string> = {
  '/': 'Forside',
  '/aktiviteter': 'Aktiviteter (oversigt)',
  '/nyheder': 'Nyheder',
  '/nyhedsbreve': 'Nyhedsbreve',
  '/udflugter': 'Udflugter',
  '/galleri': 'Galleri',
  '/udlejning': 'Udlejning',
  '/mobilepay': 'MobilePay',
  '/om-os': 'Om os',
  '/generalforsamling': 'Generalforsamling',
  '/quiz': 'Quiz',
  '/soeg': 'Søg',
  '/statistik': 'Besøgstal',
};
// Aktivitets-undersider: byg navn ud fra selve indholdet (fx /aktiviteter/banko → "Banko").
const acts = await getCollection('aktiviteter');
const ACT_LABELS = Object.fromEntries(acts.map((a) => [`/aktiviteter/${a.id}`, a.data.title]));
const PAGE_LABELS = { ...BASE_LABELS, ...ACT_LABELS };
const label = (p: string) => PAGE_LABELS[p] ?? p;

const hasData = stats.collecting && (stats.visitors > 0 || stats.pageviews > 0);

// Server-renderet og cachet i 10 minutter (stale-while-revalidate i et døgn),
// så tal fra nyåbnede ting hurtigt dukker op, uden at Vercels API rammes tit.
// En afsluttet måned ændrer sig ikke og caches et døgn (men kun med tal i).
const finished = !!month && !month.current && hasData;
Astro.response.headers.set('Cache-Control', finished
  ? 'public, s-maxage=86400, stale-while-revalidate=604800'
  : 'public, s-maxage=600, stale-while-revalidate=86400');

const nf = new Intl.NumberFormat('da-DK');
const MND = ['januar', 'februar', 'marts', 'april', 'maj', 'juni', 'juli', 'august', 'september', 'oktober', 'november', 'december'];
const monthName = (m: { year: number; month: number }) => `${MND[m.month - 1]} ${m.year}`;
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const periodText = month
  ? `i ${monthName(month)}${month.current ? ' (indtil nu)' : ''}`
  : `de sidste ${stats.rangeDays} dage`;

// Linje under en top 10: "Øvrige aktiviteter (17): 120 åbninger i alt".
const restNote = (r: RestEntry | undefined, noun: string) => {
  if (!r || r.views <= 0) return '';
  const n = r.others ? '' : ` (${r.items})`;
  return `Øvrige ${noun}${n}: ${nf.format(r.views)} ${r.views === 1 ? 'åbning' : 'åbninger'} i alt`;
};
const restActs = restNote(stats.restActivities, 'aktiviteter');
const restExc = restNote(stats.restExcursions, 'udflugter');
const restLet = restNote(stats.restLetters, 'nyhedsbreve');
const dateStr = (() => {
  const [y, m, d] = stats.updated.split('-').map(Number);
  return `${d}. ${MND[m - 1]} ${y}`;
})();

// Top-10-lister: sider (sidebesøg) + åbnede aktiviteter/udflugter/nyhedsbreve (events).
const topPages = (stats.topPages ?? []).slice(0, 10);
const topActivities = (stats.topActivities ?? []).slice(0, 10);
const topExcursions = (stats.topExcursions ?? []).slice(0, 10);
const topLetters = (stats.topLetters ?? []).slice(0, 10);
const maxPages = Math.max(1, ...topPages.map((p) => p.views));
const maxActs = Math.max(1, ...topActivities.map((p) => p.views));
const maxExc = Math.max(1, ...topExcursions.map((p) => p.views));
const maxLet = Math.max(1, ...topLetters.map((p) => p.views));
---
<BaseLayout title="Besøgstal – Selmersbo" description="Besøgstal for selmersbo.dk – anonymt og cookie-frit." noindex={true}>
  <PageHero
    eyebrow="For bestyrelsen"
    title="Besøgstal"
    lead={`Hvor mange bruger selmersbo.dk – ${periodText}. Tallene er anonyme og helt uden cookies.`}
    icon="users" />

  <section class="section" style="padding-top:2rem">
    <div class="container">
      <a class="back" href="/menu">← Menu</a>
      <nav class="periods" aria-label="Vælg periode">
        <span class="periods-label">Vis tal for</span>
        <a href="/statistik" aria-current={!month ? 'page' : undefined}>Sidste 30 dage</a>
        {months.map((m) => (
          <a href={`/statistik?periode=${m.key}`} aria-current={month?.key === m.key ? 'page' : undefined}>{cap(monthName(m))}</a>
        ))}
      </nav>
      {!hasData ? (
        month && stats.collecting ? (
          <div class="empty-box">
            <span class="empty-ic"><Icon name="clock" size={30} /></span>
            <h2>Ingen tal for {monthName(month)}</h2>
            <p>Der er ingen besøg registreret i denne måned endnu.</p>
          </div>
        ) : (
          <div class="empty-box">
            <span class="empty-ic"><Icon name="clock" size={30} /></span>
            <h2>Vi er lige begyndt at tælle</h2>
            <p>Statistikken er sat i gang. Kig forbi igen om en uges tid – så begynder tallene at komme her.</p>
          </div>
        )
      ) : (
        <>
          <div class="big-grid">
            <div class="big-card">
              <span class="big-ic"><Icon name="users" size={26} /></span>
              <strong class="big-num">{nf.format(stats.visitors)}</strong>
              <span class="big-label">Besøgende</span>
            </div>
            <div class="big-card">
              <span class="big-ic"><Icon name="image" size={26} /></span>
              <strong class="big-num">{nf.format(stats.pageviews)}</strong>
              <span class="big-label">Sidevisninger</span>
            </div>
          </div>

          {topPages.length > 0 && (
            <div class="panel">
              <h2>Mest besøgte sider <span class="tag">Top 10</span></h2>
              <ol class="bars">
                {topPages.map((p, i) => (
                  <li>
                    <span class="rank">{i + 1}</span>
                    <span class="bar-label">{label(p.path)}</span>
                    <span class="bar-track"><span class="bar-fill" style={`width:${Math.round((p.views / maxPages) * 100)}%`}></span></span>
                    <span class="bar-val">{nf.format(p.views)}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {topActivities.length > 0 && (
            <div class="panel">
              <h2>Mest åbnede aktiviteter <span class="tag">Top 10</span></h2>
              <p class="panel-sub">Hvilke aktiviteter folk åbner og læser mest om (på siden <em>Aktiviteter</em>).</p>
              <ol class="bars">
                {topActivities.map((p, i) => (
                  <li>
                    <span class="rank">{i + 1}</span>
                    <span class="bar-label">{label(p.path)}</span>
                    <span class="bar-track"><span class="bar-fill" style={`width:${Math.round((p.views / maxActs) * 100)}%`}></span></span>
                    <span class="bar-val">{nf.format(p.views)}</span>
                  </li>
                ))}
              </ol>
              {restActs && <p class="rest-note">{restActs}</p>}
            </div>
          )}

          {topExcursions.length > 0 && (
            <div class="panel">
              <h2>Mest åbnede udflugter <span class="tag">Top 10</span></h2>
              <p class="panel-sub">Hvilke udflugter folk åbner og læser mest om (på siden <em>Udflugter</em>).</p>
              <ol class="bars">
                {topExcursions.map((p, i) => (
                  <li>
                    <span class="rank">{i + 1}</span>
                    <span class="bar-label">{label(p.path)}</span>
                    <span class="bar-track"><span class="bar-fill" style={`width:${Math.round((p.views / maxExc) * 100)}%`}></span></span>
                    <span class="bar-val">{nf.format(p.views)}</span>
                  </li>
                ))}
              </ol>
              {restExc && <p class="rest-note">{restExc}</p>}
            </div>
          )}

          {topLetters.length > 0 && (
            <div class="panel">
              <h2>Mest åbnede nyhedsbreve <span class="tag">Top 10</span></h2>
              <p class="panel-sub">Hvilke måneders program og nyheder folk åbner mest (på <em>Nyheder</em> og <em>Nyhedsbreve</em>).</p>
              <ol class="bars">
                {topLetters.map((p, i) => (
                  <li>
                    <span class="rank">{i + 1}</span>
                    <span class="bar-label">{label(p.path)}</span>
                    <span class="bar-track"><span class="bar-fill" style={`width:${Math.round((p.views / maxLet) * 100)}%`}></span></span>
                    <span class="bar-val">{nf.format(p.views)}</span>
                  </li>
                ))}
              </ol>
              {restLet && <p class="rest-note">{restLet}</p>}
            </div>
          )}

          {stats.devices.length > 0 && (
            <div class="panel">
              <h2>Telefon eller computer</h2>
              <ul class="bars plain">
                {stats.devices.map((d) => (
                  <li>
                    <span class="bar-label">{d.type}</span>
                    <span class="bar-track"><span class="bar-fill" style={`width:${d.share}%`}></span></span>
                    <span class="bar-val">{nf.format(d.count)} · {d.share}%</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </>
      )}

      <p class="foot-note">
        <Icon name="check" size={18} />
        <span>Sidst opdateret {dateStr}. Tallene er anonyme og cookie-frie – der bruges ingen personoplysninger.</span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .back { display: inline-block; color: var(--green-700); font-weight: 650; margin-bottom: 1.2rem; text-decoration: none; }
  .back:hover { text-decoration: underline; }
  .empty-box { text-align: center; max-width: 40rem; margin: 1rem auto 0; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 2.6rem 2rem; }
  .empty-ic { display: inline-grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--green-050); color: var(--green-700); margin-bottom: 0.6rem; }
  .empty-box h2 { margin: 0.2rem 0 0.4rem; }
  .empty-box p { color: var(--muted); font-size: 1.08rem; margin: 0; }

  .big-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .big-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.8rem; text-align: center; display: grid; justify-items: center; gap: 0.3rem; }
  .big-ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--green-050); color: var(--green-700); margin-bottom: 0.3rem; }
  .big-num { font-family: var(--font-display); font-size: 3rem; line-height: 1; color: var(--ink); }
  .big-label { color: var(--muted); font-weight: 600; font-size: 1.05rem; }

  .panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.6rem 1.8rem; margin-top: 1.4rem; }
  .panel h2 { margin: 0 0 1rem; font-size: 1.35rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .panel-sub { margin: -0.6rem 0 1rem; color: var(--muted); }
  .tag { font-family: var(--font-sans, inherit); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--green-700); background: var(--green-050); padding: 0.2rem 0.55rem; border-radius: 999px; }

  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .bars li { display: grid; grid-template-columns: 1.6rem 12rem 1fr 4rem; align-items: center; gap: 0.9rem; }
  .bars.plain li { grid-template-columns: 12rem 1fr 6.5rem; }
  .rank { font-weight: 700; color: var(--muted); text-align: center; }
  .bar-label { font-weight: 600; }
  .bar-track { background: var(--sand); border-radius: 999px; height: 16px; overflow: hidden; }
  .bar-fill { display: block; height: 100%; background: var(--green); border-radius: 999px; }
  .bar-val { text-align: right; color: var(--muted); font-weight: 600; }

  .rest-note { max-width: none; margin: 1rem 0 0; padding-top: 0.8rem; border-top: 1px solid var(--line); color: var(--muted); font-weight: 600; }

  .periods { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0 0 1.4rem; }
  .periods-label { color: var(--muted); font-weight: 650; margin-right: 0.3rem; }
  .periods a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); color: var(--ink); font-weight: 650; text-decoration: none; }
  .periods a:hover { border-color: var(--green-400); }
  .periods a[aria-current='page'] { background: var(--green-700); border-color: var(--green-700); color: #fff; }

  .foot-note { display: flex; align-items: flex-start; gap: 0.5rem; color: var(--muted); font-size: 0.98rem; margin-top: 1.6rem; }
  .foot-note :global(svg) { color: var(--green); flex: none; margin-top: 2px; }

  @media (max-width: 620px) {
    .big-grid { grid-template-columns: 1fr; }
    .bars li { grid-template-columns: 1.4rem 6.5rem 1fr 3.2rem; gap: 0.5rem; }
    .bars.plain li { grid-template-columns: 6rem 1fr 5.4rem; }
  }
</style>
