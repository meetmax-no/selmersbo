---
import { getCollection } from 'astro:content';
import path from 'node:path';
import sharp from 'sharp';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

// Billederne i CMS-rækkefølge (5, 10, 15 …).
const entries = (await getCollection('galleri', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Billedets mål læses ved bygning, så hvert foto vises i sin naturlige form
// (høje forbliver høje) i "murstens"-opsætningen.
const photos = await Promise.all(entries.map(async ({ data }) => {
  let width = 4;
  let height = 3;
  try {
    const m = await sharp(path.join(process.cwd(), 'public', decodeURI(data.image))).metadata();
    if (m.width && m.height) {
      const turned = (m.orientation ?? 1) >= 5; // EXIF: stående/liggende byttet om
      width = turned ? m.height : m.width;
      height = turned ? m.width : m.height;
    }
  } catch { /* ukendt mål → 4:3 */ }
  return { ...data, width, height };
}));

// Startværdi for rækkehøjden (før scriptet måler den rigtige kolonnebredde).
const ROW = 8;
const span = (w: number, h: number) => Math.ceil((340 * (h / w) + 16) / ROW);
---
<BaseLayout title="Galleri – Selmersbo" description="Billeder fra livet på Aktivhuset Selmersbo.">
  <PageHero
    eyebrow="Billeder"
    title="Galleri"
    lead="Et lille kig ind i hverdagen og festdagene på Selmersbo. Klik på et billede for at se det i stort format."
    icon="users" />

  <section class="section" style="padding-top:2rem">
    <div class="container">
      {photos.length === 0 ? (
        <p class="empty">Der er ingen billeder endnu – kig forbi igen snart.</p>
      ) : (
        <div class="gallery" data-gallery>
          {photos.map((p, i) => (
            <a class="shot" href={p.image} data-ratio={(p.width / p.height).toFixed(4)} style={`--span:${span(p.width, p.height)}`}>
              <img src={p.image} alt={p.caption ?? 'Foto fra Selmersbo'} width={p.width} height={p.height} loading={i < 6 ? 'eager' : 'lazy'} />
              {p.caption && <span class="cap">{p.caption}</span>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Stor visning af ét billede (piler, swipe, tastatur). -->
  <dialog class="lb" data-lightbox aria-label="Billedvisning">
    <button class="lb-close" type="button" aria-label="Luk">✕</button>
    <figure class="lb-fig">
      <img class="lb-img" alt="" />
      <figcaption class="lb-cap"><span class="lb-text"></span><span class="lb-count"></span></figcaption>
    </figure>
    <button class="lb-btn lb-prev" type="button" aria-label="Forrige billede">‹</button>
    <button class="lb-btn lb-next" type="button" aria-label="Næste billede">›</button>
  </dialog>

  <CtaBand />
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const lb = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (grid) {
    const shots = [...grid.querySelectorAll<HTMLAnchorElement>('.shot')];

    // Murstens-opsætning: hvert billede spænder over så mange 8px-rækker,
    // som dets højde kræver ved den aktuelle kolonnebredde.
    const ROW = 8;
    const layout = () => {
      const gap = parseFloat(getComputedStyle(shots[0] ?? grid).marginBottom) || 16;
      for (const el of shots) {
        const r = parseFloat(el.dataset.ratio || '') || 4 / 3;
        const w = el.getBoundingClientRect().width;
        if (w) el.style.setProperty('--span', String(Math.ceil((w / r + gap) / ROW)));
      }
    };
    layout();
    new ResizeObserver(layout).observe(grid);

    // Billederne toner blidt frem, når man scroller ned (ikke ved "reducer bevægelse").
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      grid.classList.add('anim');
      const io = new IntersectionObserver((list) => {
        list.filter((e) => e.isIntersecting).forEach((e, k) => {
          (e.target as HTMLElement).style.transitionDelay = `${k * 70}ms`;
          e.target.classList.add('in');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -40px 0px' });
      shots.forEach((s) => io.observe(s));
    }

    // Stor visning
    if (lb) {
      const img = lb.querySelector<HTMLImageElement>('.lb-img')!;
      const text = lb.querySelector<HTMLElement>('.lb-text')!;
      const count = lb.querySelector<HTMLElement>('.lb-count')!;
      let cur = 0;

      const show = (i: number) => {
        cur = (i + shots.length) % shots.length;
        const a = shots[cur];
        img.src = a.href;
        img.alt = a.querySelector('img')?.alt ?? '';
        text.textContent = a.querySelector('.cap')?.textContent ?? '';
        count.textContent = `${cur + 1} / ${shots.length}`;
        // Hent naboerne i forvejen, så bladring føles hurtig.
        [cur + 1, cur - 1].forEach((j) => { new Image().src = shots[(j + shots.length) % shots.length].href; });
      };

      shots.forEach((a, i) => a.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        lb.showModal();
        document.documentElement.style.overflow = 'hidden';
      }));
      lb.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
        shots[cur]?.focus();
      });
      lb.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
      lb.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
      lb.querySelector('.lb-close')!.addEventListener('click', () => lb.close());
      lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
      lb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(cur - 1);
        if (e.key === 'ArrowRight') show(cur + 1);
      });

      // Swipe på mobil/tablet
      let x0: number | null = null;
      lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      lb.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
        x0 = null;
      });
    }
  }
</script>

<style>
  /* Murstens-galleri: 3 kolonner, rækkefølgen læses fra venstre mod højre. */
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 1rem; grid-auto-rows: 8px; }
  .shot {
    grid-row-end: span var(--span, 30); margin-bottom: 1rem;
    display: block; position: relative; overflow: hidden; cursor: zoom-in;
    border-radius: var(--radius); border: 1px solid var(--line); box-shadow: var(--shadow-sm);
    background: var(--green-050);
  }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .shot:hover img, .shot:focus-visible img { transform: scale(1.05); }
  .shot:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }
  .cap {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 1.4rem 0.9rem 0.7rem; font-size: 0.98rem; color: #fff; font-weight: 600;
    background: linear-gradient(transparent, rgba(20, 19, 15, 0.75));
  }

  /* Blid indtoning ved scroll */
  .gallery.anim .shot { opacity: 0; transform: translateY(16px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .gallery.anim .shot.in { opacity: 1; transform: none; }

  .empty { color: var(--muted); font-size: 1.1rem; }

  /* Stor visning */
  .lb {
    width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: none; background: rgba(15, 14, 11, 0.94); color: #fff;
  }
  .lb::backdrop { background: rgba(15, 14, 11, 0.94); }
  .lb[open] { display: grid; place-items: center; }
  .lb-fig { margin: 0; display: grid; justify-items: center; gap: 0.9rem; max-width: 92vw; }
  .lb-img {
    max-width: 92vw; max-height: calc(100vh - 9rem); max-height: calc(100dvh - 9rem);
    width: auto; height: auto; border-radius: 10px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .lb-cap { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1rem; align-items: baseline; font-size: 1.2rem; font-weight: 600; text-align: center; padding-inline: 1rem; }
  .lb-count { color: #cfc8ba; font-weight: 500; font-size: 1rem; }
  .lb-btn, .lb-close {
    position: absolute; display: grid; place-items: center; border: none; border-radius: 50%;
    background: rgba(255, 255, 255, 0.15); color: #fff; cursor: pointer; line-height: 1;
  }
  .lb-btn:hover, .lb-close:hover { background: rgba(255, 255, 255, 0.28); }
  .lb-btn:focus-visible, .lb-close:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .lb-btn { top: 50%; transform: translateY(-50%); width: 60px; height: 60px; font-size: 2.4rem; padding-bottom: 4px; }
  .lb-prev { left: 1.2rem; }
  .lb-next { right: 1.2rem; }
  .lb-close { top: 1rem; right: 1rem; width: 50px; height: 50px; font-size: 1.3rem; }

  @media (max-width: 720px) {
    .gallery { grid-template-columns: repeat(2, 1fr); column-gap: 0.7rem; }
    .shot { margin-bottom: 0.7rem; }
    .cap { font-size: 0.88rem; padding: 1.1rem 0.6rem 0.5rem; }
    .lb-btn { top: auto; bottom: 1.2rem; transform: none; width: 56px; height: 56px; }
    .lb-img { max-height: calc(100vh - 12rem); max-height: calc(100dvh - 12rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot img { transition: none; }
    .shot:hover img, .shot:focus-visible img { transform: none; }
  }
</style>
