---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';

// Build a small search index at build time (no external service, no cookies).
const anchor = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const strip = (parts: (string | undefined)[]) =>
  parts.filter(Boolean).join(' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // markdown links → text
    .replace(/[#*_>`~|]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 600);

type Item = { t: string; ty: string; u: string; x: string; ic: string };
const idx: Item[] = [];

for (const a of await getCollection('aktiviteter', ({ data }) => !data.draft))
  idx.push({ t: a.data.title, ty: 'Aktivitet', u: `/aktiviteter/${a.id}`, x: strip([a.data.day, a.data.text, a.body]), ic: a.data.icon || 'calendar' });

for (const n of await getCollection('nyheder', ({ data }) => !data.draft))
  idx.push({ t: n.data.title, ty: 'Nyhed', u: `/nyheder#${anchor(n.data.title)}`, x: strip([n.data.tag, n.data.summary, n.body]), ic: 'calendar' });

for (const b of await getCollection('nyhedsbreve', ({ data }) => !data.draft))
  idx.push({ t: b.data.title, ty: 'Nyhedsbrev', u: `/nyhedsbreve/${b.id}`, x: strip([b.data.summary, b.body]), ic: 'mail' });

for (const u of await getCollection('udflugter', ({ data }) => !data.draft))
  idx.push({ t: u.data.title, ty: 'Udflugt', u: `/udflugter/${u.id}`, x: strip([u.data.summary, u.body]), ic: 'bus' });

for (const d of await getCollection('dokumenter'))
  idx.push({ t: d.data.title, ty: 'Dokument', u: `/dokumenter/${d.id}`, x: strip([d.data.summary, d.body]), ic: 'book' });

const omos = (await getCollection('omos'))[0];
if (omos) {
  idx.push({ t: 'Om os', ty: 'Side', u: '/om-os', x: strip(['bestyrelse daglig leder de frivillige kontakt CVR', omos.data.lead, omos.data.purpose, omos.data.volunteersText]), ic: 'users' });
  // Hver person (ledelse + bestyrelse) som eget søgetræf → hopper til kortet.
  const people = [omos.data.leader, ...omos.data.board];
  for (const m of people)
    idx.push({ t: m.name, ty: m.role || 'Bestyrelse', u: `/om-os#${anchor(m.name)}`, x: strip([m.role, 'bestyrelse ledelse selmersbo']), ic: 'users' });
}

const udl = (await getCollection('udlejning'))[0];
if (udl)
  idx.push({ t: udl.data.title || 'Udlejning', ty: 'Side', u: '/udlejning', x: strip([udl.data.lead, 'leje lokaler priser sal mødelokale', (udl.data.prices || []).map((p: any) => p.label).join(' ')]), ic: 'calendar' });

// Static pages
idx.push({ t: 'Forside', ty: 'Side', u: '/', x: 'velkommen aktivhus seniorer hørsholm åbningstider kontakt', ic: 'users' });
idx.push({ t: 'Aktiviteter', ty: 'Side', u: '/aktiviteter', x: 'alle aktiviteter oversigt hver uge', ic: 'calendar' });
idx.push({ t: 'Nyheder', ty: 'Side', u: '/nyheder', x: 'nyt beskeder foredrag program', ic: 'calendar' });
idx.push({ t: 'Nyhedsbreve', ty: 'Side', u: '/nyhedsbreve', x: 'nyhedsbreve måned program arkiv', ic: 'mail' });
idx.push({ t: 'Udflugter', ty: 'Side', u: '/udflugter', x: 'ture udflugter rejser', ic: 'bus' });
idx.push({ t: 'Galleri', ty: 'Side', u: '/galleri', x: 'billeder fotos galleri', ic: 'image' });
idx.push({ t: 'Udlejning', ty: 'Side', u: '/udlejning', x: 'leje lokaler fest møde', ic: 'calendar' });
idx.push({ t: 'Mobile Pay', ty: 'Side', u: '/mobilepay', x: 'betaling mobilepay penge', ic: 'phone' });
idx.push({ t: 'Generalforsamling', ty: 'Side', u: '/generalforsamling', x: 'generalforsamling dagsorden bestyrelse', ic: 'calendar' });

const popular = ['Banko', 'Gymnastik', 'Foredrag', 'Udflugter', 'Nyhedsbreve', 'Udlejning'];
---
<BaseLayout title="Søg – Selmersbo" description="Søg på hele Selmersbos side – aktiviteter, nyheder, nyhedsbreve og mere.">
  <PageHero eyebrow="Find det, du søger" title="Søg" lead="Skriv et ord – f.eks. en aktivitet, et navn eller en måned. Resultaterne kommer med det samme." icon="search" />

  <section class="section" style="padding-top:1.5rem">
    <div class="container search-wrap">
      <div class="search-box">
        <Icon name="search" size={24} />
        <input id="q" type="search" inputmode="search" autocomplete="off" placeholder="Søg på siden …" aria-label="Søg på siden" />
        <button id="clear" type="button" aria-label="Ryd søgning" hidden>✕</button>
      </div>

      <div class="popular" id="popular">
        <span class="popular-label">Prøv f.eks.:</span>
        {popular.map((p) => <button type="button" class="tag" data-term={p}>{p}</button>)}
      </div>

      <p id="status" class="status" role="status" aria-live="polite"></p>
      <ul id="results" class="results"></ul>
    </div>
  </section>
</BaseLayout>

<script type="application/json" id="search-index" set:html={JSON.stringify(idx)}></script>

<script>
  const data = JSON.parse(document.getElementById('search-index').textContent);
  const input = document.getElementById('q');
  const clearBtn = document.getElementById('clear');
  const results = document.getElementById('results');
  const status = document.getElementById('status');
  const popular = document.getElementById('popular');
  const ICON = {
    calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
    bus: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M3 11h18"/><circle cx="7.5" cy="19" r="1.5"/><circle cx="16.5" cy="19" r="1.5"/>',
    book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
    users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>',
    phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
    image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',
    accessibility: '<circle cx="12" cy="4.5" r="1.8"/><path d="M6 8.5c2 1 4 1.5 6 1.5s4-.5 6-1.5"/><path d="M12 9v6m0 0-2.5 5.5M12 15l2.5 5.5"/>',
  };
  const svg = (n) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">${ICON[n] || ICON.calendar}</svg>`;
  const norm = (s) => s.toLowerCase().normalize('NFC');
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  function snippet(text, terms) {
    const low = norm(text);
    let pos = -1;
    for (const t of terms) { const i = low.indexOf(t); if (i >= 0 && (pos < 0 || i < pos)) pos = i; }
    if (pos < 0) return esc(text.slice(0, 130)) + (text.length > 130 ? '…' : '');
    const start = Math.max(0, pos - 40);
    let s = text.slice(start, start + 150);
    s = esc(s);
    for (const t of terms) s = s.replace(new RegExp('(' + t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig'), '<mark>$1</mark>');
    return (start > 0 ? '… ' : '') + s + '…';
  }

  function run(qRaw) {
    const q = norm(qRaw.trim());
    const has = q.length >= 2;
    clearBtn.hidden = !qRaw;
    popular.style.display = has ? 'none' : '';
    if (!has) { results.innerHTML = ''; status.textContent = ''; return; }
    const terms = q.split(/\s+/).filter(Boolean);
    const scored = [];
    for (const it of data) {
      const title = norm(it.t), body = norm(it.x);
      let score = 0, all = true;
      for (const t of terms) {
        const inT = title.includes(t), inB = body.includes(t);
        if (inT) score += title.startsWith(t) ? 6 : 4;
        if (inB) score += 1;
        if (!inT && !inB) { all = false; break; }
      }
      if (all) scored.push({ it, score });
    }
    scored.sort((a, b) => b.score - a.score || a.it.t.localeCompare(b.it.t, 'da'));
    if (!scored.length) {
      results.innerHTML = '';
      status.textContent = `Ingen resultater for "${qRaw.trim()}". Prøv et andet ord.`;
      return;
    }
    status.textContent = `${scored.length} ${scored.length === 1 ? 'resultat' : 'resultater'}`;
    results.innerHTML = scored.map(({ it }) => `
      <li><a class="result" href="${it.u}">
        <span class="result-icon">${svg(it.ic)}</span>
        <span class="result-body">
          <span class="result-top"><strong>${esc(it.t)}</strong><span class="chip">${esc(it.ty)}</span></span>
          <span class="result-snip">${snippet(it.x, terms)}</span>
        </span>
        <svg class="result-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a></li>`).join('');
  }

  input.addEventListener('input', () => run(input.value));
  clearBtn.addEventListener('click', () => { input.value = ''; run(''); input.focus(); });
  popular.addEventListener('click', (e) => {
    const b = e.target.closest('[data-term]');
    if (!b) return;
    input.value = b.dataset.term;
    run(input.value); input.focus();
  });
  // Prefill from ?q=
  const q0 = new URLSearchParams(location.search).get('q');
  if (q0) { input.value = q0; run(q0); }
  input.focus();
</script>

<style>
  .search-wrap { max-width: 760px; }
  .search-box {
    display: flex; align-items: center; gap: 0.7rem;
    background: var(--paper); border: 2px solid var(--line); border-radius: 999px;
    padding: 0.6rem 1.1rem; box-shadow: var(--shadow-sm);
  }
  .search-box:focus-within { border-color: var(--green); box-shadow: var(--shadow-md); }
  .search-box :global(svg) { color: var(--green-700); flex: none; }
  .search-box input {
    flex: 1; border: none; outline: none; background: transparent; color: var(--ink);
    font-size: 1.25rem; font-family: inherit; min-width: 0;
  }
  #clear { flex: none; border: none; background: var(--sand); color: var(--ink); cursor: pointer;
    width: 34px; height: 34px; border-radius: 50%; font-size: 1rem; line-height: 1; }
  #clear:hover { background: var(--sand-deep); }

  .popular { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 1rem; }
  .popular-label { color: var(--muted); font-weight: 600; }
  .tag {
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    border-radius: 999px; padding: 0.4rem 0.9rem; font-size: 1rem; font-family: inherit; cursor: pointer; font-weight: 600;
  }
  .tag:hover { border-color: var(--green); color: var(--green-700); }

  .status { margin: 1.3rem 0 0.6rem; color: var(--muted); font-size: 1.05rem; }
  .results { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .result {
    display: flex; align-items: center; gap: 0.9rem; text-decoration: none; color: var(--ink);
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1rem 1.1rem; box-shadow: var(--shadow-sm);
  }
  .result:hover { border-color: var(--green); box-shadow: var(--shadow-md); }
  .result-icon { flex: none; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--green-050); color: var(--green-700); }
  .result-body { flex: 1; min-width: 0; display: grid; gap: 0.2rem; }
  .result-top { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .result-top strong { font-size: 1.2rem; }
  .chip { background: var(--gold-tint); color: var(--gold-ink); border-radius: 999px; padding: 0.1rem 0.6rem; font-size: 0.8rem; font-weight: 700; }
  .result-snip { color: var(--muted); font-size: 1rem; line-height: 1.4; }
  .result-snip :global(mark) { background: var(--gold-tint); color: var(--ink); padding: 0 2px; border-radius: 3px; }
  .result-go { flex: none; color: var(--green-700); }
</style>
