---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { getSettings } from '../lib/settings';
const site = await getSettings();

const trips = (await getCollection('udflugter', ({ data }) => !data.draft))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const rendered = await Promise.all(
  trips.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
const tel = `tel:+45${site.phone.replace(/\s/g, '')}`;

const dateFmt = new Intl.DateTimeFormat('da-DK', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const formatDate = (d: Date) => {
  const s = dateFmt.format(d);
  return s.charAt(0).toUpperCase() + s.slice(1);
};
---
<BaseLayout title="Udflugter – Selmersbo" description="Kommende udflugter og ture med Aktivhuset Selmersbo.">
  <PageHero
    eyebrow="Ud i det blå"
    title="Udflugter"
    lead="Nogle af årets bedste oplevelser sker uden for huset. Tag med på tur i godt selskab – bussen kører fra Selmersbo. Klik på en udflugt for at læse mere."
    icon="bus" />

  <section class="section" style="padding-top:2rem">
    <div class="container">
      {rendered.length === 0 ? (
        <p class="empty">Der er ingen planlagte udflugter lige nu – kig forbi igen snart.</p>
      ) : (
        <div class="udf-grid">
          {rendered.map(({ item, Content }) => {
            const d = item.data;
            return (
              <>
                <a class="udf-card" href={`/udflugter/${item.id}`} data-udf={item.id} data-udf-title={d.title}>
                  <div class="udf-media">
                    {d.image
                      ? <img src={d.image} alt={d.title} loading="lazy" />
                      : <span class="udf-media-icon"><Icon name="bus" size={30} /></span>}
                    {d.soldOut && <span class="udf-sold">Udsolgt</span>}
                  </div>
                  <div class="udf-body">
                    <span class="chip"><Icon name="calendar" size={15} /> {formatDate(d.date)}</span>
                    <h3>{d.title}</h3>
                    <p>{d.summary}</p>
                    <span class="udf-open">Læs mere <Icon name="arrow" size={16} /></span>
                  </div>
                </a>

                <dialog id={`udf-${item.id}`} class="udf-dialog" aria-label={d.title}>
                  <div class="udf-dialog-inner">
                    <header class="udf-dialog-head">
                      <h2>{d.title}</h2>
                      <button class="udf-close" type="button" data-close aria-label="Luk">✕</button>
                    </header>
                    <div class="udf-scroll">
                      {d.image && <img class="udf-dialog-img" src={d.image} alt={d.title} />}
                      <div class="udf-meta">
                        <span class="chip"><Icon name="calendar" size={16} /> {formatDate(d.date)}</span>
                        {d.departure && <span class="chip chip--sand"><Icon name="clock" size={16} /> Afgang {d.departure}</span>}
                        {d.returnTime && <span class="chip chip--sand"><Icon name="pin" size={16} /> Hjemkomst {d.returnTime}</span>}
                        {d.price && <span class="chip chip--gold">{d.price}</span>}
                        {d.soldOut && <span class="chip chip--sold">Udsolgt</span>}
                      </div>
                      <article class="prose newsletter"><Content /></article>
                      <div class="udf-signup">
                        {d.soldOut ? (
                          <p class="signup-sold"><strong>Turen er udsolgt.</strong></p>
                        ) : d.signupUrl ? (
                          <a class="btn btn--primary" href={d.signupUrl} rel="noopener">Tilmeld online <Icon name="arrow" size={18} /></a>
                        ) : (
                          <>
                            <p>Betaling og tilmelding på kontoret.</p>
                            <a class="btn btn--primary" href={tel}><Icon name="phone" size={18} /> Ring {site.phone}</a>
                          </>
                        )}
                      </div>
                    </div>
                    <footer class="udf-dialog-foot">
                      <button class="btn btn--ghost" type="button" data-close>Luk</button>
                    </footer>
                  </div>
                </dialog>
              </>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <CtaBand
    eyebrow="Vil du med?"
    title="Tilmeld dig næste udflugt"
    text={`Betaling og tilmelding sker på kontoret. Ring på ${site.phone}, så hjælper vi dig med de praktiske detaljer.`} />
</BaseLayout>

<script>
  import { track } from '@vercel/analytics';
  document.querySelectorAll('a[data-udf]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const el = a as HTMLAnchorElement;
      const d = document.getElementById('udf-' + el.dataset.udf) as HTMLDialogElement | null;
      if (d && typeof d.showModal === 'function') {
        e.preventDefault();
        d.showModal();
        document.documentElement.style.overflow = 'hidden';
        try { track('Udflugt åbnet', { navn: el.dataset.udfTitle || el.dataset.udf || '' }); } catch {}
      }
    });
  });
  document.querySelectorAll('dialog.udf-dialog').forEach((node) => {
    const d = node as HTMLDialogElement;
    d.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => d.close()));
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    d.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
  });
</script>

<style>
  .udf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 1.5rem); grid-auto-rows: 1fr; }
  @media (max-width: 900px) { .udf-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .udf-grid { grid-template-columns: 1fr; } }

  .udf-card {
    display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line);
    border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm);
    text-decoration: none; color: var(--ink); height: 100%;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .udf-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--green); }
  .udf-media { flex: none; position: relative; height: 190px; background: var(--green-050); overflow: hidden; }
  .udf-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .udf-media-icon { position: absolute; inset: 0; display: grid; place-items: center; color: var(--green-700); }
  .udf-sold { position: absolute; left: 0.7rem; top: 0.7rem; font-size: 0.85rem; font-weight: 650; background: var(--terra); color: #fff; padding: 0.25rem 0.6rem; border-radius: 999px; }
  .udf-body { padding: 1.1rem 1.2rem 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .udf-body h3 { margin: 0.1rem 0 0; font-size: 1.2rem; }
  .udf-body p { margin: 0; color: var(--muted); font-size: 1rem; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .udf-open { margin-top: auto; display: inline-flex; align-items: center; gap: 0.35rem; color: var(--green-700); font-weight: 650; padding-top: 0.4rem; }

  .chip--gold { background: var(--gold-tint); color: var(--gold-ink); }
  .chip--sold { background: var(--terra-tint); color: var(--terra); }

  /* Modal */
  .udf-dialog { width: min(680px, calc(100% - 2rem)); max-width: 680px; padding: 0; border: none; border-radius: var(--radius-lg); background: var(--paper); color: var(--ink); box-shadow: var(--shadow-lg); }
  .udf-dialog::backdrop { background: rgba(20, 19, 15, 0.55); }
  .udf-dialog-inner { display: flex; flex-direction: column; max-height: 88vh; }
  .udf-dialog-head { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.4rem; border-bottom: 1px solid var(--line); }
  .udf-dialog-head h2 { margin: 0; font-size: 1.4rem; }
  .udf-close { flex: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font-size: 1.1rem; display: grid; place-items: center; }
  .udf-close:hover { background: var(--sand); }
  .udf-scroll { flex: 1 1 auto; overflow-y: auto; padding: 1.3rem 1.4rem; }
  .udf-dialog-img { width: 100%; max-height: 300px; object-fit: cover; border-radius: 12px; margin-bottom: 1rem; }
  .udf-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .udf-signup { margin-top: 1.2rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .udf-signup p { margin: 0 0 0.7rem; font-weight: 600; }
  .signup-sold { color: var(--terra); }
  .udf-dialog-foot { flex: none; padding: 0.9rem 1.4rem; border-top: 1px solid var(--line); text-align: right; }
  .empty { color: var(--muted); font-size: 1.1rem; }
</style>
