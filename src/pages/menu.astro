---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';

const links = [
  { href: '/admin', label: 'Rediger indhold', desc: 'Ret tekster, billeder og aktiviteter i CMS\'et.', icon: 'brush' },
  { href: '/guide', label: 'Redaktør-guide', desc: 'Kort vejledning til at rette indhold selv.', icon: 'book' },
  { href: '/statistik', label: 'Besøgstal', desc: 'Se hvor mange der bruger siden – anonymt.', icon: 'users' },
  { href: '/oppdatering', label: 'Opdateringer', desc: 'Hvad er lavet og ændret på siden.', icon: 'calendar' },
  { href: '/', label: 'Se hjemmesiden', desc: 'Åbn den offentlige forside.', icon: 'external' },
];
---
<BaseLayout title="Menu – Selmersbo" description="Genveje for bestyrelsen: rediger indhold, besøgstal og opdateringer." noindex={true}>
  <PageHero
    eyebrow="For bestyrelsen"
    title="Menu"
    lead="Genveje til de sider, I selv styrer. Ingen af dem vises i menuen for de besøgende."
    icon="users" />

  <section class="section" style="padding-top:1.5rem">
    <div class="container">
      <div class="menu-grid">
        {links.map((l) => (
          <a class="menu-card" href={l.href}>
            <span class="menu-ic" aria-hidden="true"><Icon name={l.icon} size={26} /></span>
            <span class="menu-text">
              <strong>{l.label}</strong>
              <span class="menu-desc">{l.desc}</span>
            </span>
            <Icon name="arrow" size={20} class="menu-go" />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .menu-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; max-width: 760px; }
  .menu-card {
    display: flex; align-items: center; gap: 1rem; height: 100%;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow-sm); padding: 1.4rem 1.5rem; text-decoration: none; color: var(--ink);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .menu-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--green); }
  .menu-ic { flex: none; width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: var(--green-050); color: var(--green-700); }
  .menu-text { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; min-width: 0; }
  .menu-text strong { font-size: 1.2rem; }
  .menu-desc { color: var(--muted); font-size: 0.98rem; }
  .menu-card :global(.menu-go) { flex: none; color: var(--green-700); }
</style>
