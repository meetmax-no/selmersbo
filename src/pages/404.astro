---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';

const links = [
  { href: '/', label: 'Forside', icon: 'users' },
  { href: '/aktiviteter', label: 'Aktiviteter', icon: 'calendar' },
  { href: '/nyheder', label: 'Nyheder', icon: 'calendar' },
  { href: '/soeg', label: 'Søg på siden', icon: 'search' },
];
---
<BaseLayout title="Siden findes ikke – Selmersbo" description="Vi kunne ikke finde den side, du leder efter.">
  <PageHero
    eyebrow="Beklager"
    title="Siden findes ikke"
    lead="Vi kunne ikke finde den side, du leder efter – måske er den flyttet eller fjernet. Prøv en af genvejene herunder, eller søg."
    icon="pin" />

  <section class="section" style="padding-top:1.5rem">
    <div class="container">
      <div class="nf-grid">
        {links.map((l) => (
          <a class="nf-link" href={l.href}>
            <span class="nf-ic" aria-hidden="true"><Icon name={l.icon} size={22} /></span>
            <span>{l.label}</span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .nf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.8rem; max-width: 620px; }
  .nf-link {
    display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--ink);
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1rem 1.2rem; font-weight: 600; box-shadow: var(--shadow-sm);
  }
  .nf-link:hover { border-color: var(--green); box-shadow: var(--shadow-md); }
  .nf-link span:nth-child(2) { flex: 1; }
  .nf-ic { flex: none; width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: var(--green-050); color: var(--green-700); }
  .nf-link :global(svg:last-child) { color: var(--green-700); flex: none; }
</style>
