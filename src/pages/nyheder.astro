---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';

const dateFmt = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'long', year: 'numeric' });
const monthFmt = new Intl.DateTimeFormat('da-DK', { month: 'long', year: 'numeric' });

// News (Køb-besked, foredrag …). Everything is shown in full inline – no "read more".
const items = await getCollection('nyheder', ({ data }) => !data.draft);
const rendered = await Promise.all(items.map(async (item) => ({ item, Content: (await render(item)).Content })));
const byOrder = (a: any, b: any) =>
  (a.item.data.order - b.item.data.order) || (b.item.data.date.getTime() - a.item.data.date.getTime());
const pinned = rendered.filter((r) => r.item.data.pinned).sort(byOrder);
const news = rendered.filter((r) => !r.item.data.pinned).sort(byOrder);

// Månedens program = the newest newsletter (kalenderen for måneden).
// Opens in a modal so man bliver på Nyheder-siden (og let kan lukke igen).
const letters = (await getCollection('nyhedsbreve', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = letters[0];
const latestMonth = latest ? monthFmt.format(latest.data.date) : '';
const LatestContent = latest ? (await render(latest)).Content : null;

const anchor = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const jump = [
  ...pinned.map((r) => ({ id: anchor(r.item.data.title), label: r.item.data.title })),
  ...news.map((r) => ({ id: anchor(r.item.data.title), label: r.item.data.title })),
];
if (latest) jump.push({ id: 'program', label: `Månedens program` });
---
<BaseLayout title="Nyheder – Selmersbo" description="Seneste nyt, faste beskeder og planlagte foredrag fra Aktivhuset Selmersbo.">
  <PageHero
    eyebrow="Aktuelt"
    title="Nyheder"
    lead="Følg med i, hvad der sker på Selmersbo. Alt står her på siden – du behøver ikke klikke dig videre."
    icon="calendar" />

  <section class="section" style="padding-top:2rem">
    <div class="container news-wrap">

      {jump.length > 1 && (
        <nav class="jump" aria-label="På denne side">
          <span class="jump-label">På denne side:</span>
          {jump.map((j) => <a href={`#${j.id}`} class="jump-link">{j.label}</a>)}
        </nav>
      )}

      {pinned.map(({ item, Content }) => (
        <aside class={`notice${item.data.image ? ' has-media' : ''}`} id={anchor(item.data.title)}>
          {item.data.image && (
            <div class="notice-media"><img src={item.data.image} alt="" loading="lazy" /></div>
          )}
          <div class="notice-body">
            <p class="notice-tag"><Icon name="check" size={18} /> {item.data.tag}</p>
            <h2>{item.data.title}</h2>
            <div class="prose newsletter"><Content /></div>
          </div>
        </aside>
      ))}

      {news.map(({ item, Content }) => (
        <article class={`news-item${item.data.image ? ' has-media' : ''}`} id={anchor(item.data.title)}>
          {item.data.image && (
            <div class="news-media"><img src={item.data.image} alt="" loading="lazy" /></div>
          )}
          <div class="news-body">
            <div class="news-meta">
              <span class="chip chip--gold">{item.data.tag}</span>
            </div>
            <h2>{item.data.title}</h2>
            {item.data.summary && <p class="news-lead">{item.data.summary}</p>}
            <div class="prose newsletter"><Content /></div>
          </div>
        </article>
      ))}

      {latest && LatestContent && (
        <>
          <a class="program" id="program" href={`/nyhedsbreve/${latest.id}`} data-program>
            <div class="program-icon" aria-hidden="true"><Icon name="calendar" size={28} /></div>
            <div class="program-body">
              <p class="program-kicker">Månedens program</p>
              <h2>Se hele programmet for {latestMonth}</h2>
              <p class="program-text">Alle aktiviteter, foredrag og arrangementer måned for måned. Du kan læse det direkte på siden – ingen PDF.</p>
            </div>
            <span class="program-go"><Icon name="arrow" size={22} /></span>
          </a>

          <dialog id="program-dialog" class="prog-dialog" aria-label={latest.data.title}>
            <div class="prog-dialog-inner">
              <header class="prog-dialog-head">
                <h2>{latest.data.title}</h2>
                <button class="prog-close" type="button" data-close aria-label="Luk">✕</button>
              </header>
              <div class="prog-body">
                <article class="prose newsletter"><LatestContent /></article>
              </div>
              <footer class="prog-dialog-foot">
                <button class="btn btn--ghost" type="button" data-close>Luk og gå tilbage til Nyheder</button>
              </footer>
            </div>
          </dialog>
        </>
      )}

      {pinned.length === 0 && news.length === 0 && !latest && (
        <p class="empty">Der er ingen nyheder lige nu – kig forbi igen snart.</p>
      )}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  // Progressive enhancement: open månedens program in a modal, so the visitor
  // stays on Nyheder. Without JS the card is a normal link to the newsletter page.
  const opener = document.querySelector('a[data-program]') as HTMLAnchorElement | null;
  const dialog = document.getElementById('program-dialog') as HTMLDialogElement | null;
  if (opener && dialog && typeof dialog.showModal === 'function') {
    opener.addEventListener('click', (e) => {
      e.preventDefault();
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
    dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
  }
</script>

<style>
  .news-wrap { display: grid; gap: clamp(1.4rem, 3.5vw, 2.2rem); }

  /* Snarveje øverst */
  .jump { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .jump-label { font-weight: 650; color: var(--muted); }
  .jump-link {
    display: inline-flex; align-items: center; padding: 0.4rem 0.9rem; border-radius: 999px;
    background: var(--paper); border: 1px solid var(--line); color: var(--ink);
    font-weight: 600; font-size: 1rem; text-decoration: none;
  }
  .jump-link:hover { border-color: var(--green-400); color: var(--green-700); }

  /* Fast besked */
  .notice {
    background: var(--gold-tint); border: 1px solid var(--gold-line); border-left: 5px solid var(--gold);
    border-radius: var(--radius); padding: clamp(1.3rem, 3vw, 1.8rem); scroll-margin-top: 90px;
  }
  .notice.has-media { display: grid; grid-template-columns: 220px 1fr; gap: clamp(1rem, 3vw, 1.6rem); }
  .notice-media { border-radius: 14px; overflow: hidden; align-self: start; }
  .notice-media img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .notice-tag { display: inline-flex; align-items: center; gap: 0.45rem; margin: 0 0 0.4rem; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-ink); }
  .notice-tag :global(svg) { color: var(--gold); }
  .notice h2 { margin: 0 0 0.5rem; font-size: clamp(1.5rem, 3vw, 1.9rem); }

  /* Nyheder – vist i fuld tekst */
  .news-item {
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow-sm); padding: clamp(1.3rem, 3vw, 1.8rem); scroll-margin-top: 90px;
  }
  .news-item.has-media { display: grid; grid-template-columns: 220px 1fr; gap: clamp(1rem, 3vw, 1.6rem); }
  .news-media { border-radius: 14px; overflow: hidden; align-self: start; }
  .news-media img { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .news-meta { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .news-item h2 { margin: 0 0 0.4rem; font-size: clamp(1.5rem, 3vw, 1.9rem); }
  .news-lead { font-size: 1.1rem; color: var(--ink); margin: 0 0 0.6rem; font-weight: 550; }

  /* Månedens program – stor klikbar genvej */
  .program {
    display: flex; align-items: center; gap: 1.1rem; text-decoration: none;
    background: var(--green-050); border: 1px solid var(--green-200);
    border-radius: var(--radius); padding: clamp(1.3rem, 3vw, 1.7rem); color: var(--ink);
    scroll-margin-top: 90px;
  }
  .program:hover { border-color: var(--green-400); box-shadow: var(--shadow-sm); }
  .program-icon { flex: none; width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center; background: var(--green-700); color: #fff; }
  .program-body { flex: 1; min-width: 0; }
  .program-kicker { margin: 0 0 0.2rem; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--green-700); }
  .program h2 { margin: 0 0 0.3rem; font-size: clamp(1.4rem, 3vw, 1.75rem); }
  .program-text { margin: 0; color: var(--muted); font-size: 1.05rem; }
  .program-go { flex: none; color: var(--green-700); }

  .empty { color: var(--muted); font-size: 1.1rem; }

  @media (max-width: 640px) {
    .notice.has-media, .news-item.has-media { grid-template-columns: 1fr; }
    .notice-media img, .news-media img { aspect-ratio: 16 / 9; }
    .program { flex-wrap: wrap; }
    .program-go { display: none; }
  }

  /* Månedens program – modal (samme mønster som Nyhedsbreve) */
  .prog-dialog {
    width: min(760px, calc(100% - 2rem)); max-width: 760px; padding: 0; border: none;
    border-radius: var(--radius-lg); background: var(--paper); color: var(--ink);
    box-shadow: var(--shadow-lg);
  }
  .prog-dialog::backdrop { background: rgba(20, 19, 15, 0.55); }
  .prog-dialog-inner { display: flex; flex-direction: column; max-height: 86vh; }
  .prog-dialog-head {
    flex: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--line); background: var(--paper);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .prog-dialog-head h2 { margin: 0; font-size: 1.45rem; }
  .prog-close {
    flex: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
    border: 1px solid var(--line); background: var(--bg); color: var(--ink);
    font-size: 1.1rem; line-height: 1; display: grid; place-items: center;
  }
  .prog-close:hover { background: var(--sand); }
  .prog-body { flex: 1 1 auto; overflow-y: auto; padding: 1.4rem 1.5rem; }
  .prog-dialog-foot { flex: none; padding: 1rem 1.5rem; border-top: 1px solid var(--line); text-align: right; }
</style>
