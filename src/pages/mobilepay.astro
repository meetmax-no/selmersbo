---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { getSettings } from '../lib/settings';
const site = await getSettings();

const number = site.mobilepay || '95956';
// Officielt MobilePay-betalingslink til et MyShop-nummer. Åbner MobilePay
// (app på telefon) med Selmersbos nummer – beløb og tekst skrives af brugeren.
const payLink = `https://mobilepay.dk/erhverv/betalingslink/betalingslink-svar?phone=${number.replace(/\s/g, '')}`;
const steps = [
  'Tryk på knappen “Betal med MobilePay” – eller åbn MobilePay på din telefon.',
  `Indtast Selmersbos nummer: ${number} (hvis du ikke brugte knappen).`,
  'Skriv beløbet og gerne en kort tekst, fx “Kontingent”.',
  'Godkend betalingen – så er du i mål.',
];
---
<BaseLayout title="MobilePay – Selmersbo" description="Betal kontingent og aktiviteter til Selmersbo med MobilePay.">
  <PageHero
    eyebrow="Betaling"
    title="Betal med MobilePay"
    lead="Du kan nemt betale kontingent, ture og arrangementer med MobilePay."
    icon="device" />

  <section class="section" style="padding-top:2rem">
    <div class="container split">
      <div class="prose">
        <h2>Kære brugere af Selmersbo</h2>
        <p>MobilePay kan bruges til at betale med på Selmersbo. Nummeret, du skal bruge, står her på siden.</p>
        <h2>Sådan gør du</h2>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="step-num">{i + 1}</span> {s}</li>
          ))}
        </ol>
        <p class="mp-link"><a href="https://www.mobilepay.dk" rel="noopener" target="_blank">Læs mere på MobilePays hjemmeside <Icon name="arrow" size={18} /></a></p>
        <p class="demo-note" style="margin-top:1.5rem"><Icon name="check" size={20} /><span>Er du i tvivl, så spørg i huset – vi hjælper dig gerne.</span></p>
      </div>

      <aside class="pay-card">
        <img class="pay-logo" src="/uploads/mobilepay-icon.svg" alt="MobilePay" width="64" height="64" loading="lazy" />
        <span class="pay-label">Betal til Selmersbo</span>
        <strong class="pay-number">{number}</strong>
        <p>Husk at skrive, hvad betalingen gælder.</p>
        <a class="pay-btn" href={payLink} rel="noopener" target="_blank">
          <img src="/uploads/mobilepay-icon.svg" alt="" width="24" height="24" /> Betal med MobilePay
        </a>
        <a class="btn btn--ghost" href={`tel:+45${site.phone.replace(/\s/g, '')}`}><Icon name="phone" size={20} /> Spørg os: {site.phone}</a>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; max-width: 60ch; }
  .steps li { display: flex; align-items: flex-start; gap: 0.8rem; font-size: 1.08rem; }
  .step-num { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--green); color: #fff; font-weight: 700; font-size: 1rem; }

  .pay-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.8rem; text-align: center; display: grid; gap: 0.4rem; justify-items: center; position: sticky; top: 96px; }
  .pay-logo { width: 64px; height: 64px; margin-bottom: 0.5rem; }
  .pay-label { color: var(--muted); font-weight: 600; }
  .mp-link a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--green-700); font-weight: 650; }
  .pay-number { font-family: var(--font-display); font-size: 2.4rem; letter-spacing: 0.12em; color: var(--ink); }
  .pay-card p { color: var(--muted); font-size: 0.98rem; margin: 0.2rem 0 0.8rem; }
  .pay-card .btn { width: 100%; }
  .pay-btn {
    width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    background: #5a78ff; color: #fff; font-weight: 700; font-size: 1.05rem; font-family: inherit;
    border: none; border-radius: 999px; padding: 0.85rem 1.2rem; text-decoration: none;
    box-shadow: var(--shadow-sm); margin-bottom: 0.6rem;
  }
  .pay-btn:hover { background: #4a68f0; color: #fff; }
  .pay-btn img { display: block; }
  @media (max-width: 860px) { .pay-card { position: static; } }
</style>
