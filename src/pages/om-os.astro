---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const values = [
  { icon: 'users', title: 'Fællesskab', text: 'Her er altid plads til én mere – og til en god snak.' },
  { icon: 'accessibility', title: 'Tilgængelighed', text: 'Hele huset er i ét plan med niveaufri adgang for alle.' },
  { icon: 'heart', title: 'Omsorg', text: 'Vi passer på hinanden – og har en sygeplejeklinik i huset.' },
];
---
<BaseLayout title="Om os – Selmersbo" description="Om Aktivhuset Selmersbo – et aktivitets- og samværshus for seniorer i Hørsholm.">
  <PageHero
    eyebrow="Om os"
    title="Aktivhuset Selmersbo"
    lead="Et aktivitets- og samværshus for seniorer i Hørsholm – med et varmt fællesskab og god plads til alle."
    icon="users" />

  <section class="section" style="padding-top:2rem">
    <div class="container split">
      <div class="prose">
        <h2>Et hus fyldt med liv</h2>
        <p>
          På Selmersbo mødes vi om det, vi holder af – sang og musik, bevægelse,
          spil, foredrag, håndarbejde og hyggeligt samvær. Huset er skabt til at
          være let at bruge for alle: alt er i ét plan, dørene er brede, og der er
          handicapvenligt toilet.
        </p>
        <p>
          Vi er en del af aktivitetscentrene i Hørsholm Kommune og drives i tæt
          samarbejde med engagerede frivillige. Uanset om du kommer for en kop
          kaffe eller for at være med til en fast aktivitet, er du velkommen.
        </p>

        <h2>Det står vi for</h2>
        <div class="grid grid--3" style="margin-top:1rem">
          {values.map((v) => (
            <div class="value card">
              <div class="value-icon" aria-hidden="true"><Icon name={v.icon} size={24} /></div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="side">
        <figure class="side-figure">
          <img src="/images/community-flags.jpg" alt="Medlemmerne samlet udenfor med flag og bogstavskilte, der staver Selmersbo" loading="lazy" width="1292" height="969" />
        </figure>
        <div class="contact card">
          <h3>Kontakt</h3>
          <ul>
            <li><Icon name="users" size={18} /> Daglig leder: {site.manager}</li>
            <li><Icon name="pin" size={18} /> {site.address.street}, {site.address.zip} {site.address.city}</li>
            <li><Icon name="phone" size={18} /> <a href={`tel:+45${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
            <li><Icon name="mail" size={18} /> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .value { text-align: left; }
  .value-icon { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: var(--green-050); color: var(--green-700); margin-bottom: 0.6rem; }
  .value h3 { margin: 0 0 0.2rem; font-size: 1.2rem; }
  .value p { margin: 0; color: var(--muted); font-size: 1rem; }

  .side { display: grid; gap: 1.2rem; position: sticky; top: 96px; }
  .side-figure { margin: 0; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-md); }
  .side-figure img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .contact h3 { margin: 0 0 0.7rem; }
  .contact ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .contact li { display: flex; align-items: center; gap: 0.55rem; color: var(--muted); }
  .contact li :global(svg) { color: var(--green); flex: none; }
  .contact a { color: var(--green-700); }
  @media (max-width: 860px) { .side { position: static; } }
</style>
