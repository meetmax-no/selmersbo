---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const features = [
  { icon: 'users', title: 'Plads til op til 60', text: 'Lyst fælleslokale med god plads til fest, reception eller møde.' },
  { icon: 'plate', title: 'Køkken', text: 'Adgang til køkken med service, så I selv kan stå for forplejningen.' },
  { icon: 'accessibility', title: 'God tilgængelighed', text: 'Alt i ét plan, brede døre og handicapvenligt toilet.' },
  { icon: 'pin', title: 'Nem parkering', text: 'Gratis parkering tæt på indgangen på Selmersvej 13.' },
];
---
<BaseLayout title="Udlejning – Selmersbo" description="Lej Selmersbos lokaler til private arrangementer i Hørsholm.">
  <PageHero
    eyebrow="Lej huset"
    title="Udlejning af lokaler"
    lead="Selmersbos lyse lokaler kan lejes til private arrangementer – fødselsdag, reception, mindesamvær eller møde."
    icon="calendar" />

  <section class="section" style="padding-top:2rem">
    <div class="container split">
      <div class="prose">
        <h2>Rammer med hjertevarme</h2>
        <p>
          Huset ligger centralt i Hørsholm med rolige, indbydende omgivelser og
          god plads. Lokalerne er velegnede til både mindre og større selskaber,
          og den niveaufri adgang gør huset let at bruge for alle gæster.
        </p>
        <p>
          Kontakt daglig leder {site.manager} for at høre om ledige datoer,
          priser og de nærmere vilkår for udlejning.
        </p>
        <div class="grid grid--2" style="margin-top:1.5rem">
          {features.map((f) => (
            <div class="feature">
              <div class="feature-icon" aria-hidden="true"><Icon name={f.icon} size={22} /></div>
              <div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <aside class="book-card">
        <h3>Forespørg om leje</h3>
        <p>Fortæl os om jeres arrangement, så vender vi tilbage med muligheder og pris.</p>
        <a class="btn btn--primary" href={`tel:+45${site.phone.replace(/\s/g, '')}`}><Icon name="phone" size={20} /> Ring {site.phone}</a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}><Icon name="mail" size={20} /> Send en mail</a>
        <p class="fineprint">Priser oplyses ved henvendelse.</p>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .feature { display: flex; gap: 0.8rem; align-items: flex-start; }
  .feature-icon { flex: none; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--green-050); color: var(--green-700); }
  .feature h3 { margin: 0 0 0.15rem; font-size: 1.15rem; }
  .feature p { margin: 0; color: var(--muted); font-size: 1rem; }

  .book-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.6rem; display: grid; gap: 0.7rem; position: sticky; top: 96px; }
  .book-card h3 { margin: 0; }
  .book-card > p { margin: 0 0 0.4rem; color: var(--muted); }
  .book-card .btn { width: 100%; }
  .fineprint { font-size: 0.92rem; color: var(--muted); margin: 0.4rem 0 0; }
  @media (max-width: 860px) { .book-card { position: static; } }
</style>
